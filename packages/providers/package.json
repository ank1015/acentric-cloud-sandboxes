{
  "name": "@acentric-sandboxes/providers",
  "version": "0.0.0",
  "private": true,
  "description": "Provider adapters for acentric Python sandboxes: the execution operations, the in-sandbox agent and one adapter per provider. Uses only fetch.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit",
    "test": "node --conditions=source --test \"test/**/*.test.ts\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@acentric-sandboxes/contracts": "workspace:*"
  }
}
