{
  "name": "@acentric-sandboxes/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Run Python in your own sandboxes (E2B, Daytona, Blaxel, Tensorlake) with one API: start, wait, kill, list, delete. Calls the acentric execution gateway, or providers directly. Bring your own keys.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "source": "./src/core.ts",
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./direct": {
      "source": "./src/direct.ts",
      "types": "./dist/direct.d.ts",
      "default": "./dist/direct.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.core.json",
    "test": "node --conditions=source --test \"test/**/*.test.ts\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@acentric-sandboxes/contracts": "workspace:*",
    "@acentric-sandboxes/providers": "workspace:*"
  }
}
